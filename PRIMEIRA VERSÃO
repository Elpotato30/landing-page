        .glass-card:hover {
            border-color: rgba(225, 6, 0, 0.5);
            box-shadow: 0 12px 32px -10px rgba(225, 6, 0, 0.25);
            transform: translateY(-4px);
        }

        /* Red & Yellow Accent Hover Lines */
        .card-accent-hover {
            position: relative;
            overflow: hidden;
        }
        .card-accent-hover::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, #e10600, #ffcc00);
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .card-accent-hover:hover::before {
            opacity: 1;
        }
