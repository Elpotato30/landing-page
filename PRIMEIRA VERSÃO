    <!-- MODAL - DRIVER DETAILS -->
    <div id="driverModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/80 backdrop-blur-md">
        <div class="glass-card max-w-2xl w-full p-6 rounded-3xl relative border border-gray-700 space-y-4">
            <button onclick="closeDriverModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white text-xl">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div id="modalContent" class="space-y-4"></div>
        </div>
    </div>

    <!-- LIGHTBOX MODAL -->
    <div id="lightboxModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/90 backdrop-blur-lg">
        <button onclick="closeLightbox()" class="absolute top-6 right-6 text-white text-3xl hover:text-rbrRed transition-colors">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <div class="max-w-4xl w-full text-center space-y-4">
            <img id="lightboxImage" src="" alt="Enlarged gallery view" class="max-h-[80vh] mx-auto rounded-2xl shadow-2xl border border-gray-800">
            <p id="lightboxCaption" class="font-racing text-sm text-rbrYellow uppercase tracking-wider"></p>
        </div>
    </div>

    <script>
        // Official Drivers Data Store
        const driverData = {
            verstappen: {
                name: "Max Verstappen",
                number: "#1",
                flag: "🇳🇱",
                country: "Holanda",
                role: "Tetracampeão Mundial de F1",
                bio: "Max Verstappen ingressou na Red Bull Racing em 2016 e estabeleceu-se como uma força dominante na Fórmula 1. Com pilotagem cirúrgica, ritmo impressionante de corrida e foco total, conquistou quatro títulos mundiais consecutivos.",
                stats: [
                    { label: "GPs Disputados", val: "200+" },
                    { label: "Vitórias", val: "61" },
                    { label: "Pódios", val: "107" },
                    { label: "Poles", val: "40" }
                ]
            },
            hadjar: {
                name: "Isack Hadjar",
                number: "#6",
                flag: "🇫🇷",
                country: "França",
                role: "Piloto Titular de F1",
                bio: "Promovido diretamente do programa Red Bull Junior Team, Isack Hadjar destaca-se pelo talento nato, pilotagem agressiva e veloz nas qualificações e capacidade de disputar posições com determinação.",
                stats: [
                    { label: "Nacionalidade", val: "Francesa" },
                    { label: "Número do Carro", val: "#6" },
                    { label: "Programa", val: "Red Bull Junior" },
                    { label: "Categoria", val: "Fórmula 1" }
                ]
            }
        };

        function openDriverModal(driverKey) {
            const data = driverData[driverKey];
            if (!data) return;

            const content = `
                <div class="flex items-center gap-4 border-b border-gray-800 pb-4">
                    <span class="text-4xl font-racing font-extrabold text-rbrRed">${data.number}</span>
                    <div>
                        <h3 class="text-2xl font-racing font-bold text-white">${data.name} ${data.flag}</h3>
                        <p class="text-rbrYellow font-racing text-xs uppercase tracking-wider">${data.role}</p>
                    </div>
                </div>
                <p class="text-gray-300 text-sm leading-relaxed">${data.bio}</p>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 text-center font-racing">
                    ${data.stats.map(s => `
                        <div class="glass-panel p-3 rounded-xl">
                            <p class="text-[10px] text-gray-400 uppercase">${s.label}</p>
                            <p class="text-base font-bold text-white mt-1">${s.val}</p>
                        </div>
                    `).join('')}
                </div>
            `;

            document.getElementById('modalContent').innerHTML = content;
            document.getElementById('driverModal').classList.remove('hidden');
        }

        function closeDriverModal() {
            document.getElementById('driverModal').classList.add('hidden');
        }

        // Lightbox Handler
        function openLightbox(imgUrl, caption) {
            document.getElementById('lightboxImage').src = imgUrl;
            document.getElementById('lightboxCaption').textContent = caption;
            document.getElementById('lightboxModal').classList.remove('hidden');
        }

        function closeLightbox() {
            document.getElementById('lightboxModal').classList.add('hidden');
        }

        // Mobile Menu Drawer Toggle
        const mobileBtn = document.getElementById('mobileMenuBtn');
        const mobileDrawer = document.getElementById('mobileDrawer');
        mobileBtn.addEventListener('click', () => {
            mobileDrawer.classList.toggle('hidden');
        });

        document.querySelectorAll('.mobile-link').forEach(link => {
            link.addEventListener('click', () => {
                mobileDrawer.classList.add('hidden');
            });
        });

        // Speed Canvas Background
        const canvas = document.getElementById('speedCanvas');
        const ctx = canvas.getContext('2d');
        let lines = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }

        function initCanvas() {
            resizeCanvas();
            lines = [];
            for (let i = 0; i < 35; i++) {
                lines.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    length: Math.random() * 80 + 30,
                    speed: Math.random() * 3 + 1.5,
                    color: Math.random() > 0.5 ? 'rgba(225, 6, 0, 0.35)' : 'rgba(255, 204, 0, 0.25)'
                });
            }
        }

        function animateCanvas() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            lines.forEach(l => {
                ctx.beginPath();
                ctx.moveTo(l.x, l.y);
                ctx.lineTo(l.x + l.length, l.y);
                ctx.strokeStyle = l.color;
                ctx.lineWidth = 1.2;
                ctx.stroke();

                l.x += l.speed;
                if (l.x > canvas.width) {
                    l.x = -l.length;
                    l.y = Math.random() * canvas.height;
                }
            });
            requestAnimationFrame(animateCanvas);
        }

        window.addEventListener('resize', resizeCanvas);

        // Counter Animation on Scroll
        let animated = false;
        const counterObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting && !animated) {
                    animated = true;
                    document.querySelectorAll('.counter').forEach(counter => {
                        const target = +counter.getAttribute('data-target');
                        let count = 0;
                        const increment = Math.ceil(target / 35);

                        const updateCount = () => {
                            count += increment;
                            if (count >= target) {
                                counter.textContent = target;
                            } else {
                                counter.textContent = count;
                                setTimeout(updateCount, 30);
                            }
                        };
                        updateCount();
                    });
                }
            });
        }, { threshold: 0.4 });

        counterObserver.observe(document.getElementById('estatisticas'));

        window.onload = function() {
            initCanvas();
            animateCanvas();
        };
    </script>
</body>
